{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:autofpl:schema:decision-snapshot-metadata:1.0",
  "title": "autoFPL decision snapshot metadata v1",
  "description": "Identifies the schema version and provenance class of an autoFPL decision snapshot.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceType"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Version of this metadata contract.",
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "sourceType": {
      "description": "How the snapshot input was obtained.",
      "type": "string",
      "enum": [
        "manual",
        "synthetic"
      ]
    }
  }
}
